global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal


snippet mk "Math" wA
$${1}$`!p
if t[2] and t[2][0] not in [',', '.', '?', '-', ' ']:
    snip.rv = ' '
else:
    snip.rv = ''
`$2
endsnippet
snippet dm "Math" wA
$$$1$$$0
endsnippet

snippet beg "begin{} / end{}" bA
\begin{$1}
$2
\end{$1}$0
endsnippet

snippet def "Définition" bA
\begin{définition}
$1
\end{définition}$0
endsnippet
snippet prop "Proposition" bA
\begin{proposition}
$1
\end{proposition}$0
endsnippet
snippet pre "Preuve" bA
\begin{preuve}
$1
\end{preuve}$0
endsnippet
snippet arr "Array" bA
\$\$\begin{array}{${1:rcl}}
$2
\end{array}\$\$$0
endsnippet


snippet 'fam([A-Za-z])' "Family" ri
(\vec{`!p snip.rv = match.group(1)`_{${1:1}}},\ldots,\vec{`!p snip.rv = match.group(1)`_{${2:n}}})
endsnippet


context "math()"
snippet // "Fraction" iA
\frac{$1}{$2}$0
endsnippet
context "math()"
snippet '((\d+)|(\d*)(\\)?([A-Za-z]+)((\^|_)(\{\d+\}|\d))*)/' "Fraction" wrA
\\frac{`!p snip.rv = match.group(1)`}{$1}$0
endsnippet
context "math()"
priority 1000
snippet '^.*\)/' "() Fraction" wrA
`!p
stripped = match.string[:-1]
depth = 0
i = len(stripped) - 1
while True:
	if stripped[i] == ')': depth += 1
	if stripped[i] == '(': depth -= 1
	if depth == 0: break;
	i -= 1
snip.rv = stripped[0:i] + "\\frac{" + stripped[i+1:-1] + "}"
`{$1}$0
endsnippet

context "math()"
snippet abs "Absolute value" iA
\left|$1\right|$0
endsnippet


context "math()"
snippet suml "sum limts" w
\sum\limits_{i=${1:1}}^{${2:n}}${3:a_i}
endsnippet
snippet sum "sum" w
\sum_{i=${1:1}}^{${2:n}}${3:a_i}
endsnippet
context "math()"
snippet lim "limit" w
\lim\limits_{${1:n} \to ${2:+\infty}}
endsnippet
context "math()"
snippet int "integral" w
\int_${1:0}^{${2:+\infty}}
endsnippet
context "math()"
snippet ens "set" w
\left\\{$1\mid $2\right\\}$0
endsnippet

context "math()"
snippet -> "to" iA
\to 
endsnippet
snippet !> "mapsto" iA
\mapsto 
endsnippet


context "math()"
snippet td "superscript" iA
^{${1:2}}$0
endsnippet
context "math()"
snippet __ "subscript" iA
_{${1:i}}$0
endsnippet
context "math()"
snippet '([A-Za-z])(\d)' "auto subscript" wrA
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet
context "math()"
snippet '([A-Za-z])_(\d\d)' "auto subscript2" wrA
`!p snip.rv = match.group(1)`_{`!p snip.rv = match.group(2)`}
endsnippet



